# Copier en keystore.properties à la racine (ignoré par git).
# Générer le keystore : keytool -genkeypair -v -keystore kidolock-release.keystore -alias kidolock -keyalg RSA -keysize 2048 -validity 10000
storeFile=kidolock-release.keystore
storePassword=VOTRE_MOT_DE_PASSE
keyAlias=kidolock
keyPassword=VOTRE_MOT_DE_PASSE_CLE
