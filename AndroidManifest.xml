<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.famille.modeenfant">

    <!-- Android 11+ : voir les applis lançables. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ModeEnfant">

        <!-- Écran parent : réglages + lancement d'une session. -->
        <activity
            android:name=".ParentActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Espace enfant : uniquement pendant une session. -->
        <activity
            android:name=".KidHomeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="fr.famille.modeenfant.kid"
            android:theme="@style/Theme.ModeEnfant.Kid" />

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:label="@string/choose_apps" />

        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>
    </application>
</manifest>
